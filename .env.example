# Konfigurasi Telegram Bot untuk Notifikasi LSPro & Lab Uji
# Salin file ini menjadi .env dan isi nilainya

# Token Bot dari @BotFather
TELEGRAM_BOT_TOKEN=isi_token_bot_disini

# Chat ID tujuan (grup/channel/pribadi)
# Grup/Channel: biasanya diawali -  (contoh: -1001234567890)
# Pribadi: angka saja (contoh: 123456789)
TELEGRAM_CHAT_ID=isi_chat_id_disini
